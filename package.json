{
  "name": "@neunoro/fastify-kit",
  "version": "0.8.0",
  "description": "Kit para el framework Fastify HTTP de alto rendimiento que utiliza Stage 3 Decorators para una experiencia de desarrollo más fluida y organizada. Proporciona una estructura modular basada en decoradores para definir controladores, proveedores y módulos, facilitando la creación de aplicaciones Fastify escalables y mantenibles.",
  "type": "module",
  "bin": {
    "fk": "./bin/fk.js",
    "fastify-kit": "./bin/fk.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": {
    "name": "Angel Gonzalez M.",
    "url": "https://github.com/xNeuNoRo"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:clean": "rm -rf dist",
    "build": "npm run build:clean && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "bullmq": "^5.78.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "mediasoup": "^3.20.5"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": false
    },
    "@sinclair/typebox": {
      "optional": false
    },
    "mediasoup": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@scalar/fastify-api-reference": "^1.61.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "fastify-plugin": "^6.0.0",
    "glob": "^13.0.6",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^24.13.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "bullmq": "^5.78.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^8.0.0",
    "ioredis": "^5.11.1",
    "lint-staged": "^16.1.5",
    "mediasoup": "^3.20.5",
    "prettier": "^3.8.4",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "ws": "^8.21.0"
  }
}
